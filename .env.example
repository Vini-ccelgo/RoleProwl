# Database (required only when database-backed features are activated)
DATABASE_URL="postgresql://roleprowl:roleprowl@localhost:5432/roleprowl"

# Authentication — Clerk (RP-002)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# AI — planned for a later ticket
OPENAI_API_KEY=
ROLEPROWL_AI_MODEL_DEFAULT=gpt-5.6-luna
ROLEPROWL_AI_TIMEOUT_MS=30000
ROLEPROWL_AI_MAX_RETRIES=2
# Optional per-task override example:
# ROLEPROWL_AI_MODEL_RESUME_TAILORING=gpt-5.6-terra

# Durable workflows — planned for a later ticket
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Document storage — the filesystem adapter is development-only
ROLEPROWL_LOCAL_STORAGE_PATH=.roleprowl-storage

# Public Greenhouse boards to ingest (operator-selected, not credentials)
# Example: [{"boardToken":"example","company":"Example Corp"}]
GREENHOUSE_BOARDS_JSON=[]

# Production object storage — provider wiring is deferred until deployment
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
