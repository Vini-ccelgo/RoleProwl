# Database (required only when database-backed features are activated)
DATABASE_URL="postgresql://roleprowl:roleprowl@localhost:5432/roleprowl"
# Direct connection used by Prisma migration commands in hosted environments.
DATABASE_URL_UNPOOLED="postgresql://roleprowl:roleprowl@localhost:5432/roleprowl"

# Authentication — Clerk (RP-002)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# AI — temporary Gemini synthetic-only manual-alpha configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
ROLEPROWL_GEMINI_MODEL_LITE=gemini-3.5-flash-lite
ROLEPROWL_GEMINI_MODEL_FLASH=gemini-3.5-flash
ROLEPROWL_GEMINI_LITE_RPM_LIMIT=12
ROLEPROWL_GEMINI_LITE_RPD_LIMIT=450
ROLEPROWL_GEMINI_FLASH_RPM_LIMIT=4
ROLEPROWL_GEMINI_FLASH_RPD_LIMIT=15
ROLEPROWL_GEMINI_SYNTHETIC_ONLY=true
ROLEPROWL_DEPLOYMENT_ENVIRONMENT=local
# Required only for a deliberately isolated synthetic preview deployment:
ROLEPROWL_ALLOW_SYNTHETIC_AI_PREVIEW=false
# Public production is blocked by default. Do not enable for the free-tier test.
ROLEPROWL_ALLOW_SYNTHETIC_AI_PRODUCTION=false
# Real candidate AI requires both Gemini real-data permission and this Preview-only gate.
# Keep false unless an operator is deliberately enabling an invited private-beta Preview.
ROLEPROWL_PRIVATE_BETA_REAL_DATA_AI_ENABLED=false

# Private-beta admission is optional and server-enforced when enabled.
ROLEPROWL_PRIVATE_BETA_ENABLED=false
# Exact, comma-separated invited Clerk account emails. Do not expose in client code or logs.
ROLEPROWL_PRIVATE_BETA_ALLOWED_EMAILS=

# Preserved OpenAI configuration — used only when AI_PROVIDER=openai
OPENAI_API_KEY=
ROLEPROWL_AI_MODEL_DEFAULT=gpt-5.6-luna
ROLEPROWL_AI_TIMEOUT_MS=30000
ROLEPROWL_AI_MAX_RETRIES=1
# Optional per-task override example:
# ROLEPROWL_AI_MODEL_RESUME_TAILORING=gpt-5.6-terra

# Personal mode only — optional public Adzuna discovery
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Personal mode only — optional OpenAI-compatible localhost server (for example Ollama)
# These variables never change the full web application's AI_PROVIDER setting.
PERSONAL_AI_PROVIDER=none
PERSONAL_AI_BASE_URL=http://127.0.0.1:11434
PERSONAL_AI_MODEL=

# Durable workflows
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Document storage — filesystem is allowed only for local/test.
ROLEPROWL_STORAGE_PROVIDER=filesystem
ROLEPROWL_LOCAL_STORAGE_PATH=.roleprowl-storage

# Hosted private S3-compatible storage. The current Preview uses Backblaze B2.
ROLEPROWL_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Public Greenhouse boards to ingest (operator-selected, not credentials)
# Example: [{"boardToken":"example","company":"Example Corp"}]
GREENHOUSE_BOARDS_JSON=[]

# Hosted smoke-test operator variables. These are not application credentials.
ROLEPROWL_TEST_BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
