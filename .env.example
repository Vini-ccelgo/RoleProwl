# Database (required only when database-backed features are activated)
DATABASE_URL="postgresql://roleprowl:roleprowl@localhost:5432/roleprowl"

# Authentication — Clerk (RP-002)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# AI — planned for a later ticket
OPENAI_API_KEY=

# Durable workflows — planned for a later ticket
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Document storage — the filesystem adapter is development-only
ROLEPROWL_LOCAL_STORAGE_PATH=.roleprowl-storage

# Production object storage — provider wiring is deferred until deployment
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
