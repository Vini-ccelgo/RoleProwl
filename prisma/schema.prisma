generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(cuid())
  authProvider             String
  externalAuthId           String
  email                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  candidateProfile         CandidateProfile?
  workExperiences          WorkExperience[]
  educationRecords         Education[]
  skills                   Skill[]
  skillEvidence            CandidateSkillEvidence[]
  projects                 Project[]
  credentials              Credential[]
  candidatePreferences     CandidatePreferences?
  workAuthorizationProfile WorkAuthorizationProfile?
  candidateDocuments       CandidateDocument[]
  documentExtractions      DocumentExtraction[]
  candidateFactProposals   CandidateFactProposal[]
  candidateFacts           CandidateFact[]
  generatedClaims          GeneratedClaim[]
  claimEvidence            GeneratedClaimEvidence[]

  @@unique([authProvider, externalAuthId])
  @@index([email])
}

enum CandidateDocumentFormat {
  PDF
  DOCX
}

enum CandidateDocumentStatus {
  PROCESSING
  EXTRACTED
  EXTRACTION_UNSUPPORTED
  FAILED
}

enum DocumentExtractionStatus {
  PENDING
  SUCCEEDED
  EXTRACTION_UNSUPPORTED
  FAILED
}

enum CandidateFactProposalStatus {
  PENDING
  ACCEPTED
  EDITED_AND_ACCEPTED
  REJECTED
}

enum GeneratedClaimClassification {
  DIRECT_FACT
  SUPPORTED_REWRITE
  SUPPORTED_INFERENCE
  UNSUPPORTED
}

model CandidateDocument {
  id               String                  @id @default(cuid())
  userId           String
  format           CandidateDocumentFormat
  status           CandidateDocumentStatus @default(PROCESSING)
  originalFileName String
  mimeType         String
  sizeBytes        Int
  contentHash      String
  storageKey       String                  @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraction       DocumentExtraction?
  proposals        CandidateFactProposal[]

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

model DocumentExtraction {
  id             String                   @id @default(cuid())
  userId         String
  documentId     String                   @unique
  status         DocumentExtractionStatus @default(PENDING)
  extractedText  String?
  characterCount Int?
  pageCount      Int?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       CandidateDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  proposals      CandidateFactProposal[]

  @@index([userId])
}

model CandidateFactProposal {
  id            String                      @id @default(cuid())
  userId        String
  documentId    String
  extractionId  String
  factType      String
  targetPath    String
  proposedValue Json
  sourceRegion  Json
  confidence    Float?
  status        CandidateFactProposalStatus @default(PENDING)
  acceptedValue Json?
  canonicalType String?
  canonicalId   String?
  reviewedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      CandidateDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extraction    DocumentExtraction          @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  canonicalFact CandidateFact?

  @@index([userId, status])
  @@index([documentId])
}

model CandidateFact {
  id                String                @id @default(cuid())
  userId            String
  factType          String
  value             Json
  verificationState VerificationState     @default(VERIFIED)
  source            FactSource            @default(RESUME_EXTRACTED)
  sourceProposalId  String                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProposal    CandidateFactProposal @relation(fields: [sourceProposalId], references: [id], onDelete: Restrict)

  @@index([userId, factType])
}

model GeneratedClaim {
  id             String                       @id @default(cuid())
  userId         String
  text           String
  classification GeneratedClaimClassification
  generator      String
  promptVersion  String
  assertions     Json                         @default("[]")
  verifiedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEvidence GeneratedClaimEvidence[]

  @@index([userId, classification])
}

model GeneratedClaimEvidence {
  id               String         @id @default(cuid())
  userId           String
  claimId          String
  evidenceType     String
  evidenceId       String
  evidenceField    String
  evidenceSnapshot Json
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim            GeneratedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceType, evidenceId, evidenceField])
  @@index([userId, evidenceType, evidenceId])
}

enum VerificationState {
  UNVERIFIED
  VERIFIED
  STALE
  DISPUTED
}

enum FactSource {
  USER_ENTERED
  RESUME_EXTRACTED
  IMPORT
  SYSTEM_COMPUTED
}

model CandidateProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  firstName         String
  lastName          String
  professionalTitle String?
  summary           String?
  phone             String?
  location          String?
  websiteUrl        String?
  linkedInUrl       String?
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id                String            @id @default(cuid())
  userId            String
  employer          String
  title             String
  employmentType    String?
  startDate         DateTime
  endDate           DateTime?
  isCurrent         Boolean           @default(false)
  location          String?
  description       String?
  responsibilities  String[]          @default([])
  achievements      String[]          @default([])
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model Education {
  id                String            @id @default(cuid())
  userId            String
  institution       String
  program           String?
  credential        String?
  startDate         DateTime?
  endDate           DateTime?
  status            String?
  coursework        String[]          @default([])
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skill {
  id                String                   @id @default(cuid())
  userId            String
  canonicalName     String
  normalizedName    String
  category          String?
  aliases           String[]                 @default([])
  proficiency       String?
  experienceMonths  Int?
  verificationState VerificationState        @default(UNVERIFIED)
  source            FactSource               @default(USER_ENTERED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence          CandidateSkillEvidence[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

model CandidateSkillEvidence {
  id                String            @id @default(cuid())
  userId            String
  skillId           String
  evidenceType      String
  evidenceId        String
  description       String?
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, evidenceType, evidenceId])
  @@index([userId])
}

model Project {
  id                String            @id @default(cuid())
  userId            String
  name              String
  role              String?
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  url               String?
  skills            String[]          @default([])
  outcomes          String[]          @default([])
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Credential {
  id                String            @id @default(cuid())
  userId            String
  name              String
  issuer            String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  credentialId      String?
  credentialUrl     String?
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidatePreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  roleFamilies         String[] @default([])
  industries           String[] @default([])
  remotePreference     String?
  locationPreferences  String[] @default([])
  salaryMinimum        Int?
  salaryCurrency       String?
  employmentTypes      String[] @default([])
  seniorities          String[] @default([])
  maximumTravelPercent Int?
  willingToRelocate    Boolean?
  exclusions           String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkAuthorizationProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  countryCode         String
  authorizationStatus String
  requiresSponsorship Boolean
  notes               String?
  verificationState   VerificationState @default(UNVERIFIED)
  source              FactSource        @default(USER_ENTERED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}
