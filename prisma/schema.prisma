generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                       @id @default(cuid())
  authProvider             String
  externalAuthId           String
  email                    String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  deletedAt                DateTime?
  candidateProfile         CandidateProfile?
  workExperiences          WorkExperience[]
  educationRecords         Education[]
  skills                   Skill[]
  skillEvidence            CandidateSkillEvidence[]
  projects                 Project[]
  credentials              Credential[]
  candidatePreferences     CandidatePreferences?
  workAuthorizationProfile WorkAuthorizationProfile?
  candidateDocuments       CandidateDocument[]
  documentExtractions      DocumentExtraction[]
  candidateFactProposals   CandidateFactProposal[]
  candidateFacts           CandidateFact[]
  generatedClaims          GeneratedClaim[]
  claimEvidence            GeneratedClaimEvidence[]
  jobMatchAnalyses         JobMatchAnalysis[]
  matchFeedback            MatchFeedback[]
  resumeVersions           ResumeVersion[]
  writingArtifacts         ApplicationWritingArtifact[]
  answerMemories           AnswerMemory[]
  applicationPolicy        ApplicationPolicy?
  reviewQueueItems         ReviewQueueItem[]
  reviewQueueAuditEvents   ReviewQueueAuditEvent[]
  applicationDecisions     ApplicationDecision[]
  applicationWorkflowRuns  ApplicationWorkflowRun[]
  applications             Application[]
  applicationEvents        ApplicationEvent[]
  notifications            Notification[]
  notificationPreferences  NotificationPreferences?
  jobSearchState           JobSearchState?
  auditEvents              AuditEvent[]
  productEvents            ProductEvent[]
  jobDispositions          CandidateJobDisposition[]

  @@unique([authProvider, externalAuthId])
  @@index([email])
}

model RateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  requestCount    Int
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

enum ProductEventType {
  JOB_DISCOVERED
  JOB_VIEWED
  JOB_SHORTLISTED
  JOB_REJECTED
  APPLICATION_PREPARED
  REVIEW_REQUESTED
  APPLICATION_SUBMITTED
  RESPONSE_RECEIVED
  INTERVIEW
  OFFER
}

model ProductEvent {
  id         String           @id @default(cuid())
  userId     String?
  eventType  ProductEventType
  entityType String
  entityId   String?
  dedupeKey  String           @unique
  properties Json
  occurredAt DateTime
  createdAt  DateTime         @default(now())
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
}

enum JobStatus {
  ACTIVE
  STALE
  EXPIRED
  CLOSED
}

enum JobRemoteType {
  ONSITE
  HYBRID
  REMOTE
}

model Job {
  id                      String                       @id @default(cuid())
  canonicalApplicationUrl String?
  company                 String
  normalizedCompany       String
  title                   String
  normalizedTitle         String
  description             String?
  locations               Json?
  remoteType              JobRemoteType?
  employmentType          String?
  seniority               String?
  salaryMin               Decimal?
  salaryMax               Decimal?
  salaryCurrency          String?
  salaryInterval          String?
  requirements            Json?
  preferredRequirements   Json?
  skills                  Json?
  educationRequirements   Json?
  experienceRequirements  Json?
  workAuthorization       Json?
  sponsorship             Json?
  postedAt                DateTime?
  expiresAt               DateTime?
  contentHash             String
  firstSeenAt             DateTime                     @default(now())
  lastSeenAt              DateTime                     @default(now())
  lastVerifiedAt          DateTime?
  status                  JobStatus                    @default(ACTIVE)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  sourceRecords           JobSourceRecord[]
  matchAnalyses           JobMatchAnalysis[]
  resumeVersions          ResumeVersion[]
  writingArtifacts        ApplicationWritingArtifact[]
  reviewQueueItems        ReviewQueueItem[]
  applicationDecisions    ApplicationDecision[]
  applicationWorkflowRuns ApplicationWorkflowRun[]
  applications            Application[]
  candidateDispositions   CandidateJobDisposition[]

  @@index([normalizedCompany, normalizedTitle])
  @@index([status, lastSeenAt])
  @@index([contentHash])
}

enum CandidateJobDispositionStatus {
  SHORTLISTED
  REJECTED
}

model CandidateJobDisposition {
  id        String                        @id @default(cuid())
  userId    String
  jobId     String
  status    CandidateJobDispositionStatus
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt
  user      User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job                           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, status, updatedAt])
}

model JobMatchAnalysis {
  id                 String          @id @default(cuid())
  userId             String
  jobId              String
  qualificationScore Int?
  preferenceScore    Int?
  overallFit         Int?
  confidence         Float
  evidenceCoverage   Float
  conflicts          Json
  hardConflicts      Json
  strengths          Json
  partialMatches     Json
  gaps               Json
  unknowns           Json
  scoringVersion     String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  feedback           MatchFeedback[]

  @@unique([userId, jobId, scoringVersion])
  @@index([userId, overallFit])
}

enum MatchFeedbackRating {
  ACCURATE
  INACCURATE
  NOT_RELEVANT
}

model MatchFeedback {
  id         String              @id @default(cuid())
  userId     String
  analysisId String
  signalCode String
  rating     MatchFeedbackRating
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis   JobMatchAnalysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([userId, analysisId, signalCode])
  @@index([analysisId])
}

model JobSourceRecord {
  id             String    @id @default(cuid())
  jobId          String
  source         String
  externalId     String
  sourceUrl      String?
  applicationUrl String?
  sourceMetadata Json?
  rawPayload     Json
  contentHash    String
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([jobId])
  @@index([applicationUrl])
}

enum JobSourceHealthStatus {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

model JobSourceHealth {
  id                  String                @id @default(cuid())
  source              String                @unique
  status              JobSourceHealthStatus @default(HEALTHY)
  consecutiveFailures Int                   @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  nextRetryAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

enum CandidateDocumentFormat {
  PDF
  DOCX
}

enum CandidateDocumentStatus {
  PROCESSING
  EXTRACTED
  EXTRACTION_UNSUPPORTED
  FAILED
}

enum DocumentExtractionStatus {
  PENDING
  SUCCEEDED
  EXTRACTION_UNSUPPORTED
  FAILED
}

enum CandidateFactProposalStatus {
  PENDING
  ACCEPTED
  EDITED_AND_ACCEPTED
  REJECTED
}

enum GeneratedClaimClassification {
  DIRECT_FACT
  SUPPORTED_REWRITE
  SUPPORTED_INFERENCE
  UNSUPPORTED
}

model CandidateDocument {
  id               String                  @id @default(cuid())
  userId           String
  format           CandidateDocumentFormat
  status           CandidateDocumentStatus @default(PROCESSING)
  originalFileName String
  mimeType         String
  sizeBytes        Int
  contentHash      String
  storageKey       String                  @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  extraction       DocumentExtraction?
  proposals        CandidateFactProposal[]

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

model DocumentExtraction {
  id             String                   @id @default(cuid())
  userId         String
  documentId     String                   @unique
  status         DocumentExtractionStatus @default(PENDING)
  extractedText  String?
  characterCount Int?
  pageCount      Int?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       CandidateDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  proposals      CandidateFactProposal[]

  @@index([userId])
}

model CandidateFactProposal {
  id            String                      @id @default(cuid())
  userId        String
  documentId    String
  extractionId  String
  factType      String
  targetPath    String
  proposedValue Json
  sourceRegion  Json
  confidence    Float?
  status        CandidateFactProposalStatus @default(PENDING)
  acceptedValue Json?
  canonicalType String?
  canonicalId   String?
  reviewedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document      CandidateDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extraction    DocumentExtraction          @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  canonicalFact CandidateFact?

  @@index([userId, status])
  @@index([documentId])
}

model CandidateFact {
  id                String                @id @default(cuid())
  userId            String
  factType          String
  value             Json
  verificationState VerificationState     @default(VERIFIED)
  source            FactSource            @default(RESUME_EXTRACTED)
  sourceProposalId  String                @unique
  status            CandidateFactStatus   @default(ACTIVE)
  removedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProposal    CandidateFactProposal @relation(fields: [sourceProposalId], references: [id], onDelete: Restrict)

  @@index([userId, factType])
}

enum CandidateFactStatus {
  ACTIVE
  REMOVED
}

model GeneratedClaim {
  id               String                       @id @default(cuid())
  userId           String
  text             String
  classification   GeneratedClaimClassification
  generator        String
  promptVersion    String
  assertions       Json                         @default("[]")
  verifiedAt       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEvidence   GeneratedClaimEvidence[]
  resumeVersions   ResumeVersionClaim[]
  writingArtifacts ApplicationWritingClaim[]

  @@index([userId, classification])
}

model ResumeVersion {
  id                  String               @id @default(cuid())
  userId              String
  targetJobId         String
  content             Json
  templateVersion     String
  generator           String
  promptVersion       String
  renderedStorageKey  String               @unique
  renderedFileName    String
  renderedContentType String
  generatedAt         DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJob           Job                  @relation(fields: [targetJobId], references: [id], onDelete: Cascade)
  applications        Application[]
  claims              ResumeVersionClaim[]

  @@index([userId, generatedAt])
  @@index([targetJobId])
}

model ResumeVersionClaim {
  resumeVersionId String
  claimId         String
  resumeVersion   ResumeVersion  @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  claim           GeneratedClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@id([resumeVersionId, claimId])
  @@index([claimId])
}

enum ApplicationWritingType {
  COVER_LETTER
  MOTIVATION_RESPONSE
  ROLE_SUMMARY
  EMPLOYER_FREE_TEXT
}

model ApplicationWritingArtifact {
  id            String                    @id @default(cuid())
  userId        String
  targetJobId   String
  type          ApplicationWritingType
  question      String?
  content       String
  generator     String
  promptVersion String
  generatedAt   DateTime                  @default(now())
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJob     Job                       @relation(fields: [targetJobId], references: [id], onDelete: Cascade)
  claims        ApplicationWritingClaim[]

  @@index([userId, generatedAt])
  @@index([targetJobId, type])
}

model ApplicationWritingClaim {
  artifactId String
  claimId    String
  artifact   ApplicationWritingArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  claim      GeneratedClaim             @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@id([artifactId, claimId])
  @@index([claimId])
}

enum AnswerMemorySource {
  PROFILE_FACT
  COMPUTED_FACT
  USER_POLICY
  EXPLICIT_CONSEQUENTIAL
}

model AnswerMemory {
  id                         String             @id @default(cuid())
  userId                     String
  concept                    String
  answer                     Json
  source                     AnswerMemorySource
  verifiedAt                 DateTime
  reverifyAfterDays          Int?
  autoAnswerAllowed          Boolean            @default(false)
  normalizedQuestionExamples String[]           @default([])
  lastUsedAt                 DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, concept])
  @@index([userId, verifiedAt])
}

enum ApplicationAutonomyLevel {
  RECOMMEND_ONLY
  AUTO_PREPARE
  AUTO_SUBMIT_AUTHORIZED
}

model ApplicationPolicy {
  id                          String                   @id @default(cuid())
  userId                      String                   @unique
  allowedRoleFamilies         String[]                 @default([])
  minimumOverallFit           Int                      @default(70)
  excludedSeniorities         String[]                 @default([])
  salaryMinimum               Int?
  allowedLocations            String[]                 @default([])
  requireRemote               Boolean                  @default(false)
  allowedEmploymentTypes      String[]                 @default([])
  rejectAuthorizationConflict Boolean                  @default(true)
  companyBlacklist            String[]                 @default([])
  dailyApplicationLimit       Int                      @default(10)
  autonomyLevel               ApplicationAutonomyLevel @default(RECOMMEND_ONLY)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  user                        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ReviewQueueStatus {
  PENDING
  APPROVED
  REJECTED
  DEFERRED
}

enum ReviewQueueAction {
  CREATED
  EDITED
  APPROVED
  REJECTED
  DEFERRED
}

model ReviewQueueItem {
  id                    String                  @id @default(cuid())
  userId                String
  jobId                 String
  status                ReviewQueueStatus       @default(PENDING)
  reasonCodes           String[]                @default([])
  fitSnapshot           Json
  applicationMaterials  Json
  unresolvedQuestions   Json
  policyResult          String
  sourceCapability      Json
  editableDraft         Json?
  resolutionNote        String?
  deferredUntil         DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                   Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationDecisionId String?                 @unique
  applicationDecision   ApplicationDecision?    @relation(fields: [applicationDecisionId], references: [id], onDelete: Cascade)
  auditEvents           ReviewQueueAuditEvent[]

  @@index([userId, status, createdAt])
  @@index([jobId])
}

model ApplicationDecision {
  id              String                   @id @default(cuid())
  userId          String
  jobId           String
  result          String
  reasonCodes     String[]                 @default([])
  inputSnapshot   Json
  inputHash       String
  policyVersion   String
  decisionVersion String
  createdAt       DateTime                 @default(now())
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewQueueItem ReviewQueueItem?
  workflowRuns    ApplicationWorkflowRun[]
  applications    Application[]

  @@unique([userId, jobId, inputHash, decisionVersion])
  @@index([userId, createdAt])
  @@index([jobId])
}

enum ApplicationWorkflowStatus {
  PENDING
  PROCESSING
  WAITING_REVIEW
  SUBMITTING
  SUBMITTED
  FAILED_RETRYABLE
  FAILED_FINAL
}

model ApplicationWorkflowRun {
  id             String                    @id @default(cuid())
  userId         String
  jobId          String
  decisionId     String
  idempotencyKey String                    @unique
  status         ApplicationWorkflowStatus @default(PENDING)
  attemptCount   Int                       @default(0)
  lastErrorCode  String?
  lastErrorAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  decision       ApplicationDecision       @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  application    Application?

  @@index([userId, status, createdAt])
  @@index([decisionId])
}

enum ApplicationState {
  DISCOVERED
  SHORTLISTED
  PREPARING
  NEEDS_REVIEW
  READY
  SUBMITTING
  SUBMITTED
  RESPONSE
  INTERVIEW
  REJECTED
  WITHDRAWN
  OFFER
  CLOSED
  FAILED
}

enum SubmissionMechanism {
  AUTHORIZED_API
  EXTERNAL_APPLICATION
  MANUAL_EXTERNAL
  UNSUPPORTED
}

enum ApplicationEventType {
  PREPARED
  READY_FOR_EXTERNAL_SUBMISSION
  SUBMISSION_STARTED
  SUBMISSION_CONFIRMED
  SUBMISSION_FAILED
  STATE_CHANGED
}

model Application {
  id                        String                  @id @default(cuid())
  userId                    String
  jobId                     String
  decisionId                String?
  workflowRunId             String?                 @unique
  resumeVersionId           String?
  state                     ApplicationState        @default(PREPARING)
  fitSnapshot               Json
  generatedTextSnapshot     Json
  answersSnapshot           Json
  documentsSnapshot         Json
  policyResultSnapshot      Json
  submissionPayloadSnapshot Json
  submissionMechanism       SubmissionMechanism
  submissionDestination     String?
  externalSubmissionId      String?
  submittedAt               DateTime?
  externalConfirmedAt       DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                       Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  decision                  ApplicationDecision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  workflowRun               ApplicationWorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  resumeVersion             ResumeVersion?          @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  events                    ApplicationEvent[]

  @@index([userId, state, updatedAt])
  @@index([jobId])
  @@index([decisionId])
}

model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  actorUserId   String?
  type          ApplicationEventType
  fromState     ApplicationState?
  toState       ApplicationState
  detail        Json?
  createdAt     DateTime             @default(now())
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
}

enum NotificationType {
  APPLICATION_NEEDS_REVIEW
  WORKFLOW_FAILED
  JOB_UNAVAILABLE
  QUESTION_NEEDS_ANSWER
  APPLICATION_SUBMITTED
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  dedupeKey  String
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  applicationUpdates Boolean  @default(true)
  jobUpdates         Boolean  @default(true)
  reviewRequired     Boolean  @default(true)
  workflowFailures   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum JobSearchStatus {
  RUNNING
  COMPLETED
  FAILED
}

model JobSearchState {
  id              String          @id @default(cuid())
  userId          String          @unique
  status          JobSearchStatus
  startedAt       DateTime
  completedAt     DateTime?
  discoveredCount Int             @default(0)
  newCount        Int             @default(0)
  failureCode     String?
  failureMessage  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
}

enum AuditAction {
  CANDIDATE_FACT_VERIFIED
  CANDIDATE_FACT_CHANGED
  CANDIDATE_FACT_REMOVED
  POLICY_CHANGED
  APPLICATION_GENERATED
  CLAIM_BLOCKED
  QUESTION_ANSWERED
  REVIEW_APPROVED
  APPLICATION_SUBMITTED
  SUBMISSION_FAILED
  STATUS_CHANGED
  ACCOUNT_EXPORT_REQUESTED
  ACCOUNT_DELETION_REQUESTED
}

model AuditEvent {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json
  createdAt   DateTime    @default(now())
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

enum AccountDeletionStatus {
  PENDING
  CLEANUP_REQUIRED
  COMPLETE
}

model AccountDeletionRequest {
  id             String                @id @default(cuid())
  subjectHash    String
  externalAuthId String?
  storageKeys    Json
  status         AccountDeletionStatus @default(PENDING)
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([subjectHash, createdAt])
}

model ReviewQueueAuditEvent {
  id          String            @id @default(cuid())
  queueItemId String
  actorUserId String
  action      ReviewQueueAction
  before      Json?
  after       Json?
  note        String?
  createdAt   DateTime          @default(now())
  queueItem   ReviewQueueItem   @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  actor       User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([queueItemId, createdAt])
  @@index([actorUserId, createdAt])
}

model GeneratedClaimEvidence {
  id               String         @id @default(cuid())
  userId           String
  claimId          String
  evidenceType     String
  evidenceId       String
  evidenceField    String
  evidenceSnapshot Json
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim            GeneratedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceType, evidenceId, evidenceField])
  @@index([userId, evidenceType, evidenceId])
}

enum VerificationState {
  UNVERIFIED
  VERIFIED
  STALE
  DISPUTED
}

enum FactSource {
  USER_ENTERED
  RESUME_EXTRACTED
  IMPORT
  SYSTEM_COMPUTED
}

model CandidateProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  firstName         String
  lastName          String
  applicationEmail  String?
  professionalTitle String?
  summary           String?
  phone             String?
  location          String?
  countryCode       String?
  websiteUrl        String?
  linkedInUrl       String?
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id                String            @id @default(cuid())
  userId            String
  employer          String
  title             String
  employmentType    String?
  startDate         DateTime
  endDate           DateTime?
  isCurrent         Boolean           @default(false)
  location          String?
  description       String?
  responsibilities  String[]          @default([])
  achievements      String[]          @default([])
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model Education {
  id                String            @id @default(cuid())
  userId            String
  institution       String
  program           String?
  credential        String?
  startDate         DateTime?
  endDate           DateTime?
  status            String?
  coursework        String[]          @default([])
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skill {
  id                String                   @id @default(cuid())
  userId            String
  canonicalName     String
  normalizedName    String
  category          String?
  aliases           String[]                 @default([])
  proficiency       String?
  experienceMonths  Int?
  verificationState VerificationState        @default(UNVERIFIED)
  source            FactSource               @default(USER_ENTERED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence          CandidateSkillEvidence[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

model CandidateSkillEvidence {
  id                String            @id @default(cuid())
  userId            String
  skillId           String
  evidenceType      String
  evidenceId        String
  description       String?
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, evidenceType, evidenceId])
  @@index([userId])
}

model Project {
  id                String            @id @default(cuid())
  userId            String
  name              String
  role              String?
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  url               String?
  skills            String[]          @default([])
  outcomes          String[]          @default([])
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Credential {
  id                String            @id @default(cuid())
  userId            String
  name              String
  issuer            String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  credentialId      String?
  credentialUrl     String?
  verificationState VerificationState @default(UNVERIFIED)
  source            FactSource        @default(USER_ENTERED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidatePreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  roleFamilies         String[] @default([])
  industries           String[] @default([])
  remotePreference     String?
  locationPreferences  String[] @default([])
  salaryMinimum        Int?
  salaryCurrency       String?
  employmentTypes      String[] @default([])
  seniorities          String[] @default([])
  maximumTravelPercent Int?
  willingToRelocate    Boolean?
  exclusions           String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkAuthorizationProfile {
  id                  String            @id @default(cuid())
  userId              String            @unique
  countryCode         String
  authorizationStatus String
  requiresSponsorship Boolean
  notes               String?
  verificationState   VerificationState @default(UNVERIFIED)
  source              FactSource        @default(USER_ENTERED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}
